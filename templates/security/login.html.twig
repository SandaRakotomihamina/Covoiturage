{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title text-center">Connexion</h3>
                    <p class="text-muted text-center mb-0 mt-2" style="font-size: 0.9rem;">Accédez à votre compte</p>
                </div>
                <div class="card-body">
                    {% if error %}
                        <div class="alert alert-danger d-flex align-items-flex-start">
                            <span style="margin-right: 0.5rem; font-size: 1.1rem; margin-top: 0.2rem;"></span>
                            <div>
                                <strong>Erreur de connexion</strong><br>
                                <small>{{ error.messageKey|trans(error.messageData, 'security') }}</small>
                            </div>
                        </div>
                    {% endif %}

                    <form method="post" id="loginForm">
                        <!-- Email Field -->
                        <div class="mb-4" style="position: relative;">
                            <input type="email" 
                                   value="{{ last_username }}" 
                                   name="email" 
                                   id="inputEmail" 
                                   class="form-control floating-input" 
                                   autocomplete="email" 
                                   placeholder=" "
                                   required 
                                   autofocus>
                            <label for="inputEmail" class="floating-label">Adresse email</label>
                            <div id="emailError" class="invalid-feedback" style="display: none; margin-top: 0.5rem; color: var(--error);"></div>
                        </div>

                        <!-- Password Field -->
                        <div class="mb-4" style="position: relative;">
                            <div style="position: relative;">
                                <input type="password" 
                                       name="password" 
                                       id="inputPassword" 
                                       class="form-control floating-input" 
                                       autocomplete="current-password" 
                                       placeholder=" "
                                       required
                                       style="padding-right: 2.5rem;">
                                <label for="inputPassword" class="floating-label">Mot de passe</label>
                                <button type="button" class="btn-toggle-password" id="togglePassword" aria-label="Afficher le mot de passe"
                                        style="position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; padding: 0.5rem; z-index: 10;">
                                    <svg id="togglePasswordIcon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                </button>
                            </div>
                            <small id="passwordHelp" class="form-text text-muted">Votre mot de passe personnel</small>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <div class="d-grid">
                            <button class="btn btn-primary" type="submit" style="font-weight: 500; padding: 0.75rem;">
                                Se connecter
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-center">
                    <p class="mb-0">Pas encore de compte ? <a href="{{ path('app_register') }}" style="font-weight: 500;">S'inscrire</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.floating-label {
    position: absolute;
    left: 0.75rem;
    top: 1rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-secondary);
    pointer-events: none;
    transition: all 0.3s ease;
    opacity: 1;
}

.floating-input:focus + .floating-label,
.floating-input:not(:placeholder-shown) + .floating-label,
.floating-input.has-value + .floating-label {
    opacity: 1;
    top: -0.75rem;
    font-size: 0.7rem;
    color: var(--accent);
}

.floating-input {
    padding-top: 1.8rem !important;
    padding-bottom: 0.6rem !important;
}

.floating-input:focus {
    border-color: var(--accent) !important;
    box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.1) !important;
}

.btn-toggle-password {
    color: var(--text-secondary);
    transition: color 0.3s ease;
}

.btn-toggle-password:hover {
    color: var(--accent);
}

.invalid-input {
    border-color: var(--error) !important;
    background-color: rgba(220, 53, 69, 0.05) !important;
}
</style>

<script>
(function () {
    function initLoginForm() {
        const emailInput = document.getElementById('inputEmail');
        const passwordInput = document.getElementById('inputPassword');
        const togglePasswordBtn = document.getElementById('togglePassword');
        const emailError = document.getElementById('emailError');

        // Floating input handler
        const floatingInputs = document.querySelectorAll('.floating-input');
        floatingInputs.forEach(input => {
            if (input.dataset.floatingAttached) {
                return;
            }
            input.dataset.floatingAttached = 'true';

            if (!input.value) {
                input.placeholder = ' ';
            } else {
                input.classList.add('has-value');
            }

            input.addEventListener('focus', function() {
                if (!this.value) this.placeholder = ' ';
            });
            input.addEventListener('blur', function() {
                if (!this.value) this.placeholder = '';
            });
            input.addEventListener('input', function() {
                this.classList.toggle('has-value', !!this.value);
            });
        });

        // Toggle password visibility
        if (togglePasswordBtn && passwordInput && !togglePasswordBtn.dataset.toggleAttached) {
            togglePasswordBtn.dataset.toggleAttached = 'true';
            togglePasswordBtn.addEventListener('click', function(e) {
                e.preventDefault();
                const isPassword = passwordInput.type === 'password';
                passwordInput.type = isPassword ? 'text' : 'password';
                const icon = document.getElementById('togglePasswordIcon');
                if (icon) {
                    icon.innerHTML = isPassword
                        ? '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>'
                        : '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
                }
            });
        }

        // Email validation
        if (emailInput && !emailInput.dataset.emailAttached) {
            emailInput.dataset.emailAttached = 'true';
            emailInput.addEventListener('input', function() {
                const email = this.value;
                const isValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

                if (email === '') {
                    this.classList.remove('invalid-input');
                    emailError.style.display = 'none';
                } else if (!isValid) {
                    this.classList.add('invalid-input');
                    emailError.style.display = 'block';
                    emailError.textContent = 'Adresse email invalide';
                } else {
                    this.classList.remove('invalid-input');
                    emailError.style.display = 'none';
                }
            });
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLoginForm);
    } else {
        initLoginForm();
    }
    document.addEventListener('turbo:load', initLoginForm);
})();
</script>
{% endblock %}