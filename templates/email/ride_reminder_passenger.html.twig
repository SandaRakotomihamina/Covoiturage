{# Email de rappel envoyé au passager 1 heure avant le départ #}
<html>
<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
            background-color: #f9f9f9;
        }
        .header {
            background-color: #ff9800;
            color: white;
            padding: 20px;
            border-radius: 5px 5px 0 0;
            text-align: center;
        }
        .content {
            background-color: white;
            padding: 20px;
            border: 1px solid #ddd;
            border-radius: 0 0 5px 5px;
        }
        .alert {
            background-color: #fff3cd;
            border-left: 4px solid #ff9800;
            padding: 15px;
            border-radius: 3px;
            margin: 20px 0;
        }
        .ride-details {
            background-color: #f0f8ff;
            padding: 15px;
            border-left: 4px solid #007bff;
            margin: 20px 0;
            border-radius: 3px;
        }
        .driver-info {
            background-color: #f5f5f5;
            padding: 15px;
            border-radius: 3px;
            margin: 20px 0;
        }
        .info-row {
            margin: 10px 0;
        }
        .label {
            font-weight: bold;
            color: #333;
        }
        .footer {
            text-align: center;
            margin-top: 20px;
            font-size: 12px;
            color: #666;
        }
        .urgency {
            font-size: 18px;
            color: #ff9800;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>⏰ Rappel : Votre trajet en covoiturage dans 1 heure</h1>
        </div>
        <div class="content">
            <p>Bonjour <strong>{{ passenger.name }}</strong>,</p>
            
            <div class="alert">
                <p style="margin: 0;"><span class="urgency">⚠️ Attention :</span> Votre trajet commence dans <strong>1 heure</strong>!</p>
            </div>

            <p>Voici les détails de votre réservation :</p>

            <div class="ride-details">
                <h3 style="margin-top: 0; color: #007bff;">Détails du trajet</h3>
                <div class="info-row">
                    <span class="label">📍 De :</span> {{ ride.departure }}
                </div>
                <div class="info-row">
                    <span class="label">📍 Vers :</span> {{ ride.destination }}
                </div>
                <div class="info-row">
                    <span class="label">🕐 Départ exact :</span> {{ ride.departureTime|date('d/m/Y à H:i') }}
                </div>
                {% if ride.notes %}
                    <div class="info-row">
                        <span class="label">📝 Notes du conducteur :</span> {{ ride.notes }}
                    </div>
                {% endif %}
            </div>

            <div class="driver-info">
                <h3 style="margin-top: 0; color: #333;">Informations du conducteur</h3>
                <div class="info-row">
                    <span class="label">👤 Nom :</span> {{ driver.name }}
                </div>
                <div class="info-row">
                    <span class="label">🚗 Voiture :</span> {{ driver.carModel ?? 'Non spécifiée' }}
                </div>
                <div class="info-row">
                    <span class="label">📧 Email :</span> {{ driver.email }}
                </div>
                <div class="info-row">
                    <span class="label">📱 Téléphone :</span> {{ driver.phone ?? 'Non fourni' }}
                </div>
            </div>

            <p style="color: #d32f2f; font-weight: bold;">✅ Assurez-vous d'être prêt 10-15 minutes avant l'heure de départ!</p>

            <p>Merci d'utiliser notre service de covoiturage!</p>

            <div class="footer">
                <p>Cet email a été généré automatiquement par le système de covoiturage.</p>
            </div>
        </div>
    </div>
</body>
</html>
