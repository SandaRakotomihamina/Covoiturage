{% extends 'base.html.twig' %}

{% block title %}Profil{% endblock %}

{% block body %}
<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">Mon Profil</h3>
          <p class="text-muted mb-0 mt-2" style="font-size: 0.9rem;">Gérez vos informations personnelles et votre voiture</p>
        </div>
        <div class="card-body">
          <form>
            <div class="mb-4">
              <h5 style="color: var(--text-primary); margin-bottom: 1rem;">Informations personnelles</h5>
              <div class="mb-3">
                <label for="name" class="form-label">Nom complet</label>
                <input type="text" class="form-control" id="name" name="name" value="{{ user.name }}" required aria-describedby="nameHelp" readonly>
                <small id="nameHelp" class="form-text text-muted">Le nom qui s'affichera pour les autres utilisateurs</small>
              </div>
              <div class="mb-3">
                <label for="email" class="form-label">Adresse email</label>
                <input type="email" class="form-control" id="email" name="email" value="{{ user.email }}" readonly style="background-color: var(--bg-secondary);">
                <small class="form-text text-muted">Votre adresse email ne peut pas être modifiée</small>
              </div>
            </div>

            <div class="mb-4">
              <h5 style="color: var(--text-primary); margin-bottom: 1rem;">Information sur votre voiture</h5>
              {% if user.hasCar %}
                <div class="alert alert-secondary py-2">
                  {% if user.imageCar %}
                    <div class="mt-3">
                      {# image voiture conducteur avec fallback #}
                      <div class="mb-3">
                          <img src="{{ user.imageCar ? user.imageCar : asset('images/default.png') }}" alt="Photo de la voiture de {{ user.name }}" class="img-fluid rounded car-photo-preview" style="max-width: 180px; object-fit: cover; border: 1px solid var(--border-color);">
                      </div>
                    </div>
                  {% else %}
                    <div class="mb-3">
                      <img src="{{ asset('images/default.png') }}" alt="Photo de la voiture" class="img-fluid rounded car-photo-preview" style="max-width: 180px; object-fit: cover; border: 1px solid var(--border-color);">
                    </div>
                  {% endif %}
                  <p class="mb-1"><strong>Modèle :</strong> {{ user.carModel }}</p>
                  <p class="mb-0"><strong>Places disponibles :</strong> {{ user.availableSeats }}</p>
                </div>
              {% else %}
                <div class="alert alert-secondary py-2">
                  <p class="mb-0">Vous n'avez pas encore renseigné de voiture. Allez dans les paramètres pour ajouter des informations de véhicule.</p>
                </div>
              {% endif %}
            </div>

            <div class="d-grid gap-2 d-md-flex justify-content-md-between">
              <a href="{{ path('app_ride_index') }}" class="btn btn-secondary">Retour</a>
              <a href="{{ path('app_profile_settings') }}" class="btn btn-primary" style="font-weight: 500;">Gérer les paramètres</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Confirm modal (used when saving on settings page; kept for compatibility) -->
<div class="modal fade" id="profileConfirmModal" tabindex="-1" aria-labelledby="profileConfirmModalLabel" aria-hidden="true" style="z-index: 2000;">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header border-0">
        <h5 class="modal-title" id="profileConfirmModalLabel">Confirmer la mise à jour</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>
      <div class="modal-body">
        <p>Pour confirmer vos modifications, saisissez votre mot de passe actuel.</p>
        <div class="mb-3">
          <label for="confirm_password" class="form-label">Mot de passe</label>
          <input type="password" class="form-control" id="confirm_password" name="confirm_password" autocomplete="current-password">
        </div>
        <p class="text-muted" style="font-size: 0.75rem;">Si vous changez votre mot de passe, indiquez votre ancien mot de passe.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
        <button type="button" id="confirmProfileSave" class="btn btn-primary" disabled>Confirmer</button>
      </div>
    </div>
  </div>
</div>

{% endblock %}


